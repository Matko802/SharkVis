# Maintainer: Matko Hradsky <matkohrad@proton.me>

pkgname=sharkvis-git
pkgbase=sharkvis-git
_pkgname=sharkvis
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal audio spectrum analyzer"
arch=('x86_64' 'aarch64')
url="https://github.com/Matko802/SharkVis"
license=('custom')
depends=('libpulse' 'glibc')
makedepends=('git' 'gcc' 'make' 'pkg-config')
provides=('sharkvis')
conflicts=('sharkvis')
source=("$_pkgname::git+https://github.com/Matko802/SharkVis.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --always --tags --dirty | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$_pkgname"
  make
}

package() {
  cd "$_pkgname"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
